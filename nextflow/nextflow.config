// RNA-seq Agent Pipeline — Nextflow configuration
// Profiles: local (default), awsbatch
// The agent (src/tools/nextflow/stage_runner.py) passes every param explicitly and adds a
// generated -c overrides file (executor, queue, region, workDir) from the run's settings.

nextflow.enable.dsl = 2

params {
    help            = false
    workflow        = 'qc'
    output_dir      = './results'
    sample_id       = 'sample'
    threads         = 8
    memory          = '16 GB'           // per process; the agent passes execution.memory_gb
    read_group      = ''                // @RG ID/SM for STAR (default: sample_id)

    // inputs
    fastq_r1        = null
    fastq_r2        = null
    bam             = null
    bai             = null
    genome_dir      = null
    gtf_path        = null
    salmon_index    = null
    rsem_reference  = null
    reference_fasta = null

    // options
    alignment_mode  = 'genome'          // genome | transcriptome | both
    quant_mode      = 'star_htseq'      // star_htseq | salmon | rsem
    snp_filter      = 'QD < 2.0 || FS > 60.0'
    indel_filter    = 'QD < 2.0 || FS > 200.0'

    // All processes run in the project's tools image, whose tool versions are pinned in
    // docker/tool_versions.txt — the same versions as local execution (safety Rule 8).
    // Use an immutable tag (e.g. the release / git SHA), never 'latest', in production.
    tools_image     = 'agent-rnaseq-tools:dev'

    // AWS Batch (awsbatch profile)
    aws_batch_queue = ''
    s3_work_dir     = 's3://nextflow-work/'
    aws_region      = 'us-east-1'
}

process {
    container = params.tools_image
}

profiles {

    // Local executor, processes in the tools image via Docker (executor = nextflow).
    local {
        process.executor = 'local'
        workDir          = '/tmp/nextflow_work'
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    // Local executor, tools taken from PATH (e.g. the pinned conda env in
    // environment/rnaseq-tools.yml) — no Docker needed. Set NEXTFLOW_LOCAL_PROFILE=localtools.
    localtools {
        process.executor = 'local'
        workDir          = '/tmp/nextflow_work'
        docker.enabled   = false
    }

    // AWS Batch: one Batch job per process, running the tools image (which must contain
    // the AWS CLI and `ps`; see docker/Dockerfile.tools).
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = params.aws_batch_queue
        aws.region       = params.aws_region
        workDir          = params.s3_work_dir
    }

    // Small resources for tiny test datasets (combine: -profile localtools,test).
    test {
        params.threads = 2
        params.memory  = '2 GB'
    }
}
